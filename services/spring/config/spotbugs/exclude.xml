<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs exclusions for the Alexandria Spring services.
  Keep this list short and justified: every entry here is a bug pattern we
  consciously decided not to gate on, not a way to silence real findings.
-->
<FindBugsFilter>
  <!-- OpenAPI client code is generated into build/generated by openApiGenerate.
       We don't own it and can't fix its warnings, so keep it out of analysis. -->
  <Match>
    <Class name="~com\.alexandria\.genai\.client\..*"/>
  </Match>

  <!-- Defensive-copy patterns. Our JPA entities and DTOs hand out references to
       mutable fields (dates, collections) on purpose; these are internal services
       behind auth, not a library exposed to untrusted callers. Gating on them
       would drown the real findings in dozens of false positives. -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2,MS_EXPOSE_REP"/>
  </Match>

  <!-- JPA entities are never serialized to disk/over the wire by us, so a missing
       serialVersionUID is noise rather than a bug. -->
  <Match>
    <Bug pattern="SE_NO_SERIALVERSIONID"/>
  </Match>

  <!-- The request id echoed back by MdcLoggingFilter is validated against a strict
       allowlist ([A-Za-z0-9._-]) before it ever reaches setHeader, so CR/LF response
       splitting is impossible. SpotBugs' analysis can't see through the regex
       guard, so this is a false positive. -->
  <Match>
    <Class name="com.alexandria.common.logging.MdcLoggingFilter"/>
    <Bug pattern="HRS_REQUEST_PARAMETER_TO_HTTP_HEADER"/>
  </Match>
</FindBugsFilter>
