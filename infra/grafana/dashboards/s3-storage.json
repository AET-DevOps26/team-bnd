					"refId": "A"
				}
			],
			"title": "SeaweedFS version",
			"type": "stat"
		},
		{
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"fieldConfig": {
				"defaults": {
					"color": { "mode": "thresholds" },
					"max": 100,
					"min": 0,
					"thresholds": {
						"mode": "absolute",
						"steps": [
							{ "color": "green", "value": null },
							{ "color": "yellow", "value": 75 },
							{ "color": "red", "value": 90 }
						]
					},
					"unit": "percent"
				},
				"overrides": []
			},
			"gridPos": { "h": 5, "w": 8, "x": 16, "y": 0 },
