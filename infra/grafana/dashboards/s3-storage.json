					"refId": "A"
				}
			],
			"title": "S3 request rate by status code",
			"type": "timeseries"
		},
		{
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"fieldConfig": {
				"defaults": {
					"color": { "mode": "palette-classic" },
