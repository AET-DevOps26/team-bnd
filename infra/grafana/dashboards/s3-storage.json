				{
					"datasource": { "type": "prometheus", "uid": "prometheus" },
					"expr": "histogram_quantile(0.99, sum(rate(SeaweedFS_s3_request_seconds_bucket{job=\"s3-storage\"}[5m])) by (le))",
					"legendFormat": "p99",
