# Copy this file to `.env` for production or CI deployments and insert secrets or
# override defaults.
# For local development, the docker-compose.yml file provides safe fallback defaults,
# so a .env file is only needed if you want to override those values.
#
# The .env file is gitignored and should never be committed.

# Secrets of length n chars can be generated e.g. via
# tr -dc A-Za-z0-9 </dev/urandom | head -c n; echo

# To override any environment variable, copy this file to '.env' and uncomment the
# respective line.

# ----------------------------------------------------------------------------------
# Spring Service
# ----------------------------------------------------------------------------------

# One of ERROR, WARN, INFO, DEBUG, or TRACE
# SPRING_LOG_LEVEL=INFO

# ----------------------------------------------------------------------------------
# GenAI Service
# ----------------------------------------------------------------------------------

# GENAI_LOG_LEVEL=info
# GENAI_BASE_URL=http://genai:8000

# LLM provider: "logos" (default, TUM-provided), "openai", or "ollama" (local)
# LLM_PROVIDER=logos

# LLM_BASE_URL=https://logos.aet.cit.tum.de/v1
# LLM_MODEL=openai/gpt-oss-120b

# For Ollama local dev (set LLM_PROVIDER=ollama):
# OLLAMA_BASE_URL=http://localhost:11434

# LLM API key for the GenAI service
# Logos (default): use your lg-... key issued by the course tutors
# OpenAI: use your sk-... key
# LLM_API_KEY="lg-your-api-key"

# Embedding provider for the RAG pipeline: "logos" (default), "openai", or
# "ollama". The logos/openai providers default to LLM_BASE_URL and LLM_API_KEY
# so a single-provider setup needs no extra config; ollama uses OLLAMA_BASE_URL.
# EMBEDDING_PROVIDER=logos
# EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B

# Override these only to run embeddings on a different endpoint/key than the chat
# model (e.g. chat on Logos, embeddings on OpenAI). Fall back to LLM_* when unset.
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY="sk-your-embedding-key"

# Chunking for indexing (characters per chunk and overlap between chunks)
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200

# Number of chunks retrieved per question in /genai/ask
# RAG_TOP_K=5

# Weaviate (RAG vector database) URL. Only the genai service talks to it.
# In docker-compose this is the in-network address; in k8s the genai
# configmap wires the in-cluster service name automatically.
# WEAVIATE_URL=http://weaviate:8080
# WEAVIATE_GRPC_PORT=50051


# ----------------------------------------------------------------------------------
# OpenID Connect
# ----------------------------------------------------------------------------------

# OIDC_ISSUER_URI=http://localhost/auth/realms/alexandria
# OIDC_JWK_SET_URI=http://keycloak:8180/auth/realms/alexandria/protocol/openid-connect/certs
# OIDC_USER_ID_CLAIM=sub
# OIDC_USERNAME_CLAIM=preferred_username
# OIDC_ROLES_CLAIM=roles

# Keycloak (OIDC provider)

# Keycloak OIDC client redirect URI (allowed callback URL after login)
# Override for non-localhost deployments (e.g. https://your-domain.com/*)
# KEYCLOAK_REDIRECT_URI="http://localhost/*"
# Keycloak OIDC client web origin (for CORS)
# Override for non-localhost deployments (e.g. https://your-domain.com)
# KEYCLOAK_WEB_ORIGIN="http://localhost"

# KC_BOOTSTRAP_ADMIN_USERNAME="admin"
# KC_BOOTSTRAP_ADMIN_PASSWORD="secret-with-64-bit-entropy-eg-16-hex-chars"

# ----------------------------------------------------------------------------------
# Database (PostgreSQL)
# ----------------------------------------------------------------------------------

# POSTGRES_DB="alexandria"
# POSTGRES_USER="admin"
# POSTGRES_PASSWORD="secret-with-64-bit-entropy-eg-16-hex-chars"
# POSTGRES_PORT=5432

# ----------------------------------------------------------------------------------
# Monitoring (Prometheus / Grafana)
# ----------------------------------------------------------------------------------

# Grafana admin login. Defaults to "admin" / "admin" locally
# GRAFANA_ADMIN_PASSWORD="secret-with-64-bit-entropy-eg-16-hex-chars"
# S3 Object Storage (SeaweedFS)
# ----------------------------------------------------------------------------------

# S3_REGION=eu-central-1
# S3_ACCESS_KEY=admin
# S3_SECRET_KEY=locals3password
# S3_BUCKET=alexandria-storage
