# This .env file contains publicly accessible variables, e.g. config settings.
# It should be commited to the repository.

# Postgres
POSTGRES_PORT=5432

# GenAI service
GENAI_LOG_LEVEL=info

# OIDC
OIDC_ISSUER_URI=http://localhost:8180/realms/alexandria
OIDC_JWK_SET_URI=http://keycloak:8180/realms/alexandria/protocol/openid-connect/certs
OIDC_USER_ID_CLAIM=sub
OIDC_USERNAME_CLAIM=preferred_username
OIDC_ROLES_CLAIM=roles
