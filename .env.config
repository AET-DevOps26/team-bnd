# This .env file contains publicly accessible variables, e.g. config settings.
# It should be commited to the repository.

# Postgres
POSTGRES_PORT=5432

# GenAI service
GENAI_LOG_LEVEL=info
# LLM provider: "logos" (default, TUM-provided), "openai", or "ollama" (local)
LLM_PROVIDER=logos
# Logos: OpenAI-compatible API hosted by TUM course organizers (requires TUM network / eduVPN)
# See https://logos.aet.cit.tum.de -- API key (lg-...) is set in .env as LLM_API_KEY
LLM_BASE_URL=https://logos.aet.cit.tum.de/v1
LLM_MODEL=openai/gpt-oss-120b
# For Ollama local dev (set LLM_PROVIDER=ollama):
# OLLAMA_BASE_URL=http://localhost:11434

# OIDC
OIDC_ISSUER_URI=http://localhost:8180/realms/alexandria
OIDC_JWK_SET_URI=http://keycloak:8180/realms/alexandria/protocol/openid-connect/certs
OIDC_USER_ID_CLAIM=sub
OIDC_USERNAME_CLAIM=preferred_username
OIDC_ROLES_CLAIM=roles
